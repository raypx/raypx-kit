{
  "name": "@raypx-kit/drizzle-kit",
  "version": "0.0.0-alpha.0",
  "description": "drizzle-kit's CLI and defineConfig without the unused prebuilt API and payload bundles.",
  "homepage": "https://github.com/raypx/raypx-kit/tree/canary/packages/drizzle-kit",
  "license": "MIT",
  "author": {
    "name": "Zack",
    "email": "heyloyep@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raypx/raypx-kit.git",
    "directory": "packages/drizzle-kit"
  },
  "bin": {
    "drizzle-kit": "./dist/bin.cjs"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "bun --check --tsconfig-override tsconfig.json",
    "test": "bun --bun vp test --run",
    "test:unit": "bun --bun vp test --run --passWithNoTests --exclude '**/component.test.{ts,tsx}' --exclude '**/*.component.test.{ts,tsx}' --exclude '**/*.integration.test.{ts,tsx}'",
    "test:integration": "bun --bun vp test --run --passWithNoTests integration.test",
    "test:component": "bun --bun vp test --run --passWithNoTests component.test",
    "test:coverage": "bun --bun vp test --run --passWithNoTests --coverage --coverage.reporter=text --coverage.reporter=json --coverage.reporter=lcov",
    "build": "bun src/extract.ts",
    "pack:check": "bun pm pack --dry-run --ignore-scripts"
  },
  "dependencies": {
    "@drizzle-team/brocli": "^0.12.0",
    "@js-temporal/polyfill": "^0.5.1",
    "esbuild": "^0.25.10",
    "get-tsconfig": "^4.13.6",
    "jiti": "^2.6.1"
  },
  "devDependencies": {
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-kit": ">=1.0.0-rc.5-5935859 <1.0.0-rc.5-z",
    "drizzle-orm": ">=1.0.0-rc.5-5935859 <1.0.0-rc.5-z",
    "semver": "^7.8.5"
  },
  "engines": {
    "node": ">=22.14"
  }
}
