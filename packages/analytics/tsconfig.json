{
  "extends": "@raypx-kit/tsconfig/node.json",
  "compilerOptions": {
    "lib": ["ES2022", "ES2022.Intl", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["tests/fixtures/**", "e2e/**"]
}
