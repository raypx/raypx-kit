{
  "name": "@raypx-kit/logger",
  "version": "0.0.0-alpha.4",
  "description": "Evlog structured logging, wide events, drain pipelines and request-scoped context.",
  "homepage": "https://github.com/raypx/raypx-kit/tree/canary/packages/logger",
  "license": "Apache-2.0",
  "author": {
    "name": "Zack",
    "email": "heyloyep@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raypx/raypx-kit.git",
    "directory": "packages/logger"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./context": {
      "types": "./dist/context.d.mts",
      "import": "./dist/context.mjs"
    },
    "./pipeline": {
      "types": "./dist/pipeline.d.mts",
      "import": "./dist/pipeline.mjs"
    },
    "./safe": {
      "types": "./dist/safe.d.mts",
      "import": "./dist/safe.mjs"
    },
    "./stream": {
      "types": "./dist/stream.d.mts",
      "import": "./dist/stream.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "tsc --noEmit --project tsconfig.json",
    "test": "vp test --run",
    "test:unit": "vp test --run --passWithNoTests --exclude '**/component.test.{ts,tsx}' --exclude '**/*.component.test.{ts,tsx}' --exclude '**/*.integration.test.{ts,tsx}'",
    "test:integration": "vp test --run --passWithNoTests integration.test",
    "test:component": "vp test --run --passWithNoTests component.test",
    "test:coverage": "vp test --run --passWithNoTests --coverage --coverage.reporter=text --coverage.reporter=json --coverage.reporter=lcov",
    "build": "vp pack",
    "dev": "vp pack --watch",
    "pack:check": "pnpm pack --dry-run"
  },
  "dependencies": {
    "evlog": "^2.34.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5"
  },
  "engines": {
    "node": ">=22.21"
  }
}
