{
  "name": "@raypx-kit/tsconfig",
  "version": "0.0.0-alpha.3",
  "description": "Strict TypeScript presets for ESM libraries, browser applications and Node-compatible runtimes.",
  "homepage": "https://github.com/raypx/raypx-kit/tree/canary/packages/tsconfig",
  "license": "Apache-2.0",
  "author": {
    "name": "Zack",
    "email": "heyloyep@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raypx/raypx-kit.git",
    "directory": "packages/tsconfig"
  },
  "files": [
    "base.json",
    "browser.json",
    "library.json",
    "node.json",
    "react-library.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    "./base.json": "./base.json",
    "./browser.json": "./browser.json",
    "./node.json": "./node.json",
    "./library.json": "./library.json",
    "./react-library.json": "./react-library.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "tsc --noEmit --project tsconfig.json",
    "test": "vp test --run",
    "test:unit": "vp test --run --passWithNoTests --exclude '**/component.test.{ts,tsx}' --exclude '**/*.component.test.{ts,tsx}' --exclude '**/*.integration.test.{ts,tsx}'",
    "test:integration": "vp test --run --passWithNoTests integration.test",
    "test:component": "vp test --run --passWithNoTests component.test",
    "test:coverage": "vp test --run --passWithNoTests --coverage --coverage.reporter=text --coverage.reporter=json --coverage.reporter=lcov",
    "pack:check": "pnpm pack --dry-run"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.0"
  },
  "engines": {
    "node": ">=22.21"
  }
}
