{
  "name": "@raypx-kit/storage",
  "version": "0.0.0-alpha.2",
  "description": "Object storage behind one interface: S3-compatible, filesystem and memory drivers with signed upload and download URLs.",
  "homepage": "https://github.com/raypx/raypx-kit/tree/canary/packages/storage",
  "license": "Apache-2.0",
  "author": {
    "name": "Zack",
    "email": "heyloyep@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raypx/raypx-kit.git",
    "directory": "packages/storage"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./signed": {
      "types": "./dist/signed.d.mts",
      "import": "./dist/signed.mjs"
    },
    "./memory": {
      "types": "./dist/memory.d.mts",
      "import": "./dist/memory.mjs"
    },
    "./fs": {
      "types": "./dist/fs.d.mts",
      "import": "./dist/fs.mjs"
    },
    "./s3": {
      "types": "./dist/s3.d.mts",
      "import": "./dist/s3.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "bun --check --tsconfig-override tsconfig.json",
    "test": "bun --bun vp test --run",
    "test:unit": "bun --bun vp test --run --passWithNoTests --exclude '**/component.test.{ts,tsx}' --exclude '**/*.component.test.{ts,tsx}' --exclude '**/*.integration.test.{ts,tsx}'",
    "test:integration": "bun --bun vp test --run --passWithNoTests integration.test",
    "test:component": "bun --bun vp test --run --passWithNoTests component.test",
    "test:coverage": "bun --bun vp test --run --passWithNoTests --coverage --coverage.reporter=text --coverage.reporter=json --coverage.reporter=lcov",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "pack:check": "bun pm pack --dry-run"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5"
  },
  "engines": {
    "node": ">=22.21"
  }
}
