{
  "name": "@raypx-kit/notifications",
  "version": "0.0.0-alpha.0",
  "description": "Knock notification workflows, signed user tokens and optional React notification feeds.",
  "homepage": "https://github.com/raypx/raypx-kit/tree/canary/packages/notifications",
  "license": "Apache-2.0",
  "author": {
    "name": "Zack",
    "email": "heyloyep@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raypx/raypx-kit.git",
    "directory": "packages/notifications"
  },
  "files": [
    "dist",
    "styles.css",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": [
    "./styles.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./react": {
      "types": "./dist/react.d.mts",
      "import": "./dist/react.mjs"
    },
    "./styles.css": "./styles.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "bun --check --tsconfig-override tsconfig.json",
    "test": "bun --bun vp test --run",
    "test:unit": "bun --bun vp test --run",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "pack:check": "bun pm pack --dry-run",
    "test:e2e": "bun ../../e2e/run.ts --project notifications"
  },
  "dependencies": {
    "@knocklabs/node": "^1.40.0"
  },
  "devDependencies": {
    "@knocklabs/react": "^0.14.0",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "peerDependencies": {
    "@knocklabs/react": "^0.14.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@knocklabs/react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.21"
  }
}
