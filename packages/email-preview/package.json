{
  "name": "@raypx-kit/email-preview",
  "version": "0.0.0-alpha.3",
  "description": "Preview React Email templates in a Vite dev server or a standalone CLI.",
  "homepage": "https://github.com/raypx/raypx-kit/tree/canary/packages/email-preview",
  "license": "Apache-2.0",
  "author": {
    "name": "Zack",
    "email": "heyloyep@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raypx/raypx-kit.git",
    "directory": "packages/email-preview"
  },
  "files": [
    "dist",
    "examples",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "imports": {
    "#components/*": "./src/ui/components/*.tsx",
    "#lib/*": "./src/ui/lib/*.ts",
    "#hooks/*": "./src/ui/hooks/*.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "bun --check --tsconfig-override tsconfig.json",
    "build": "tsdown && vp build",
    "dev": "bun run build && vp dev --config examples/vite.config.ts",
    "test": "bun --bun vp test --run",
    "test:unit": "bun --bun vp test --run",
    "pack:check": "bun pm pack --dry-run",
    "test:e2e": "bun ../../e2e/run.ts --project email-preview"
  },
  "dependencies": {
    "@react-email/render": "^2.2.0",
    "prettier": "^3.9.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@raypx-kit/themes": "workspace:*",
    "@raypx-kit/tsconfig": "workspace:*",
    "@raypx-kit/ui": "workspace:*",
    "@react-email/components": "^1.0.12",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.46",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@^1.4.0",
    "vite-plus": "^1.4.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^8.0.0"
  },
  "engines": {
    "node": ">=22.21"
  }
}
