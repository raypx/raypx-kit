{
  "name": "@raypx-kit/email-preview",
  "version": "0.0.0-alpha.5",
  "description": "Preview React Email templates in a Vite dev server with a prebuilt interface.",
  "homepage": "https://github.com/raypx/raypx-kit/tree/canary/packages/email-preview",
  "license": "Apache-2.0",
  "author": {
    "name": "Zack",
    "email": "heyloyep@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raypx/raypx-kit.git",
    "directory": "packages/email-preview"
  },
  "files": [
    "dist",
    "examples",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "imports": {
    "#components/*": "./src/ui/components/*.tsx",
    "#lib/*": "./src/ui/lib/*.ts",
    "#hooks/*": "./src/ui/hooks/*.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "tsc --noEmit --project tsconfig.json",
    "build": "vp pack && vp build --config vite.app.config.ts",
    "dev": "pnpm run build && vp dev --config examples/vite.config.ts",
    "test": "vp test --run",
    "test:unit": "vp test --run",
    "pack:check": "pnpm pack --dry-run",
    "test:e2e": "tsx ../../e2e/run.ts --project email-preview"
  },
  "dependencies": {
    "@react-email/render": "catalog:",
    "prettier": "^3.10.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@raypx-kit/themes": "workspace:*",
    "@raypx-kit/tsconfig": "workspace:*",
    "@raypx-kit/ui": "workspace:*",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-router": "^1.170.46",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-email": "catalog:",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@^1.6.0",
    "vite-plus": "^1.6.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^8.0.0"
  },
  "engines": {
    "node": ">=22.21"
  }
}
