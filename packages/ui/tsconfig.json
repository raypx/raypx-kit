{
  "extends": "@raypx-kit/tsconfig/browser.json",
  "compilerOptions": {
    "paths": {
      "#components/*": ["./src/components/*"],
      "#lib/*": ["./src/lib/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx", "*.config.ts"],
  "exclude": ["tests/fixtures/**", "e2e/**"]
}
