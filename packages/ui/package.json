{
  "name": "@raypx-kit/ui",
  "version": "0.0.0-alpha.0",
  "private": true,
  "description": "Accessible Base UI and shadcn primitives for React and Tailwind CSS.",
  "homepage": "https://github.com/raypx/raypx-kit/tree/canary/packages/ui",
  "license": "Apache-2.0",
  "author": {
    "name": "Zack",
    "email": "heyloyep@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raypx/raypx-kit.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist",
    "styles.css",
    "LICENSE",
    "NOTICE.md",
    "THIRD_PARTY_LICENSES.txt",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./components/ui/button": {
      "types": "./dist/components/ui/button.d.mts",
      "import": "./dist/components/ui/button.mjs"
    },
    "./components/ui/input": {
      "types": "./dist/components/ui/input.d.mts",
      "import": "./dist/components/ui/input.mjs"
    },
    "./components/ui/tabs": {
      "types": "./dist/components/ui/tabs.d.mts",
      "import": "./dist/components/ui/tabs.mjs"
    },
    "./components/ui/badge": {
      "types": "./dist/components/ui/badge.d.mts",
      "import": "./dist/components/ui/badge.mjs"
    },
    "./components/ui/dialog": {
      "types": "./dist/components/ui/dialog.d.mts",
      "import": "./dist/components/ui/dialog.mjs"
    },
    "./components/ui/skeleton": {
      "types": "./dist/components/ui/skeleton.d.mts",
      "import": "./dist/components/ui/skeleton.mjs"
    },
    "./components/ui/native-select": {
      "types": "./dist/components/ui/native-select.d.mts",
      "import": "./dist/components/ui/native-select.mjs"
    },
    "./lib/utils": {
      "types": "./dist/lib/utils.d.mts",
      "import": "./dist/lib/utils.mjs"
    },
    "./styles.css": "./styles.css"
  },
  "scripts": {
    "check": "bun --check --tsconfig-override tsconfig.json",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "bun --bun vp test --run",
    "test:unit": "bun --bun vp test --run",
    "pack:check": "bun pm pack --dry-run",
    "test:e2e": "bun ../../e2e/run.ts --project ui"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@raypx-kit/themes": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/node": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "engines": {
    "node": ">=22.21"
  }
}
