{
  "name": "@raypx-kit/themes",
  "version": "0.0.0-alpha.1",
  "description": "Neutral theme tokens, safe first-paint scripts, and React theme state.",
  "homepage": "https://github.com/raypx/raypx-kit/tree/canary/packages/themes",
  "license": "Apache-2.0",
  "author": {
    "name": "Zack",
    "email": "heyloyep@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raypx/raypx-kit.git",
    "directory": "packages/themes"
  },
  "files": [
    "dist",
    "styles.css",
    "tailwind.css",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./config": {
      "types": "./dist/config.d.mts",
      "import": "./dist/config.mjs"
    },
    "./script": {
      "types": "./dist/script.d.mts",
      "import": "./dist/script.mjs"
    },
    "./styles.css": "./styles.css",
    "./tailwind.css": "./tailwind.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate:theme": "bun scripts/generate-theme.ts",
    "check": "bun scripts/generate-theme.ts --check && bun --check --tsconfig-override tsconfig.json",
    "build": "bun scripts/generate-theme.ts --check && bun --bun vp pack",
    "dev": "bun --bun vp pack --watch",
    "test": "bun --bun vp test --run",
    "test:unit": "bun --bun vp test --run",
    "pack:check": "bun pm pack --dry-run",
    "test:e2e": "bun ../../e2e/run.ts --project themes"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.21"
  }
}
