{
  "name": "raypx-kit",
  "private": true,
  "license": "Apache-2.0",
  "author": {
    "name": "Zack",
    "email": "heyloyep@gmail.com"
  },
  "workspaces": [
    "docs",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "vp config --hooks --no-agent",
    "raypx-kit-dev": "bun scripts/cli.ts",
    "doctor": "bun run raypx-kit-dev doctor",
    "toolchain:check": "bun run raypx-kit-dev toolchain check",
    "architecture:check": "bun run raypx-kit-dev architecture check",
    "codemod": "bun packages/codemods/src/cli.ts",
    "build": "turbo run build",
    "check": "bun --check --tsconfig-override tsconfig.json && turbo run check",
    "test": "bun run test:toolchain && turbo run test --summarize",
    "test:toolchain": "bun --bun vp test --run --config vitest.config.ts",
    "lint": "vp check",
    "format": "vp fmt",
    "knip": "knip",
    "verify:toolchain": "bun run doctor && bun run toolchain:check",
    "verify:source": "bun run licenses:check && bun run architecture:check && bun run lint && bun run check && bun run knip",
    "verify:tests": "bun run test:toolchain && turbo run test build --summarize",
    "verify:artifacts": "bun run pack:check && bun run release:check",
    "verify": "bun run verify:toolchain && bun run verify:source && bun run verify:tests && bun run verify:e2e && bun run verify:artifacts",
    "verify:quick": "bun run verify:toolchain && bun run verify:source && bun run test",
    "pack:check": "bun scripts/packages/check.ts",
    "compatibility:check": "bun scripts/packages/compatibility.ts",
    "release:check": "bun scripts/release/check.ts",
    "changeset": "changeset",
    "version-packages": "bun run changeset version && bun install && bun run licenses:update && bun run format",
    "release:plan": "bun run raypx-kit-dev release plan",
    "release:pack": "bun run raypx-kit-dev release pack",
    "release:publish": "bun run raypx-kit-dev release publish",
    "release:snapshot": "bun run raypx-kit-dev release snapshot",
    "release:ci": "bun run release:pack && bun run release:publish",
    "docs:dev": "turbo run dev --filter=docs",
    "docs:build": "turbo run build --filter=docs",
    "docs:preview": "bun run --cwd docs preview",
    "docs:check": "bun run --cwd docs check",
    "docs:deploy": "wrangler deploy",
    "licenses:update": "bun run raypx-kit-dev licenses",
    "licenses:check": "bun run raypx-kit-dev licenses --check",
    "test:e2e": "bun e2e/run.ts",
    "test:e2e:install": "playwright install chromium",
    "verify:e2e": "bun e2e/run.ts --skip-build"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.64.1",
    "@raypx-kit/tsconfig": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "citty": "^0.2.2",
    "knip": "^6.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "semver": "^7.8.5",
    "tsdown": "^0.23.4",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vite-plus": "^1.3.0",
    "wrangler": "^4.155.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@^1.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.3",
      "onFail": "error"
    },
    "runtime": {
      "name": "bun",
      "version": "1.4.3",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "24.22.0"
  },
  "packageManager": "bun@1.4.3"
}
