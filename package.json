{
  "name": "raypx-kit",
  "private": true,
  "license": "Apache-2.0",
  "author": {
    "name": "Zack",
    "email": "heyloyep@gmail.com"
  },
  "workspaces": {
    "packages": [
      "docs",
      "packages/*"
    ],
    "catalog": {
      "@react-email/render": "^2.2.0"
    }
  },
  "type": "module",
  "scripts": {
    "prepare": "bun --bun vp config --hooks --no-agent",
    "raypx-kit-dev": "bun scripts/cli.ts",
    "doctor": "bun run raypx-kit-dev doctor",
    "toolchain:check": "bun run raypx-kit-dev toolchain check",
    "architecture:check": "bun run raypx-kit-dev architecture check",
    "codemod": "bun packages/codemods/src/cli.ts",
    "build": "bun scripts/tasks/run.ts build",
    "check": "bun scripts/tasks/run.ts check",
    "test": "bun scripts/tasks/run.ts test",
    "test:toolchain": "bun --bun vp test --run --config vitest.config.ts",
    "lint": "bun --bun vp check",
    "format": "bun --bun vp fmt",
    "knip": "bun node_modules/knip/bin/knip.js",
    "verify:toolchain": "bun run doctor && bun run toolchain:check",
    "verify:source": "bun run licenses:check && bun run architecture:check && bun run lint && bun run check && bun run knip",
    "verify:tests": "bun scripts/tasks/run.ts test:build",
    "verify:artifacts": "bun run pack:check && bun run release:check",
    "verify": "bun scripts/verify/run.ts",
    "verify:quick": "bun scripts/verify/run.ts --quick",
    "pack:check": "bun scripts/packages/check.ts",
    "compatibility:check": "bun scripts/packages/compatibility.ts",
    "release:check": "bun scripts/release/check.ts",
    "changeset": "bun node_modules/@changesets/cli/bin.js",
    "version-packages": "bun run changeset version && bun install && bun run licenses:update && bun run format",
    "release:plan": "bun run raypx-kit-dev release plan",
    "release:pack": "bun run raypx-kit-dev release pack",
    "release:publish": "bun run raypx-kit-dev release publish",
    "release:snapshot": "bun run raypx-kit-dev release snapshot",
    "release:ci": "bun run raypx-kit-dev release pack --from-compatibility .artifacts/compatibility && bun run release:publish",
    "docs:dev": "bun scripts/tasks/run.ts dev --filter=docs",
    "docs:build": "bun scripts/tasks/run.ts build --filter=docs",
    "docs:preview": "bun run --cwd docs preview",
    "docs:check": "bun run --cwd docs check",
    "docs:deploy": "bun run docs:build:cloudflare && TOOLKIT_DOCS_BUILT=1 node node_modules/wrangler/bin/wrangler.js deploy",
    "licenses:update": "bun run raypx-kit-dev licenses",
    "licenses:check": "bun run raypx-kit-dev licenses --check",
    "test:e2e": "bun e2e/run.ts",
    "test:e2e:install": "bun --bun playwright install chromium",
    "verify:e2e": "bun e2e/run.ts --skip-build",
    "docs:build:cloudflare": "bun run --cwd docs build:cloudflare"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.64.1",
    "@raypx-kit/tsconfig": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "citty": "^0.2.2",
    "confbox": "^0.3.2",
    "knip": "^6.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "semver": "^7.8.5",
    "typescript": "^7.0.2",
    "vite-plus": "^1.4.0",
    "wrangler": "^4.155.0"
  },
  "overrides": {
    "@react-email/render": "catalog:",
    "vite": "npm:@voidzero-dev/vite-plus-core@^1.4.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "error"
    },
    "runtime": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "error"
    }
  },
  "packageManager": "bun@1.4.4"
}
