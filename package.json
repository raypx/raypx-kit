{
  "name": "raypx-kit",
  "private": true,
  "license": "Apache-2.0",
  "author": {
    "name": "Zack",
    "email": "heyloyep@gmail.com"
  },
  "bin": {
    "raypx-kit-dev": "./bin/raypx-kit-dev.mjs"
  },
  "workspaces": {
    "packages": [
      "docs",
      "packages/*"
    ],
    "catalog": {
      "@react-email/render": "^2.2.0"
    }
  },
  "type": "module",
  "scripts": {
    "prepare": "vp config --hooks --no-agent",
    "raypx-kit-dev": "node bin/raypx-kit-dev.mjs",
    "doctor": "pnpm run raypx-kit-dev doctor",
    "toolchain:check": "pnpm run raypx-kit-dev toolchain check",
    "architecture:check": "pnpm run raypx-kit-dev architecture check",
    "codemod": "tsx packages/codemods/src/cli.ts",
    "build": "tsx scripts/tasks/run.ts build",
    "check": "tsx scripts/tasks/run.ts check",
    "test": "tsx scripts/tasks/run.ts test",
    "test:toolchain": "vp test --run --config vitest.config.ts",
    "lint": "vp check",
    "format": "vp fmt",
    "knip": "knip",
    "verify:toolchain": "pnpm run doctor && pnpm run toolchain:check",
    "verify:source": "pnpm run licenses:check && pnpm run architecture:check && pnpm run lint && pnpm run check && pnpm run knip",
    "verify:tests": "tsx scripts/tasks/run.ts test:build",
    "verify:artifacts": "pnpm run pack:check && pnpm run release:check",
    "verify": "tsx scripts/verify/run.ts",
    "verify:quick": "tsx scripts/verify/run.ts --quick",
    "pack:check": "tsx scripts/packages/check.ts",
    "compatibility:check": "tsx scripts/packages/compatibility.ts",
    "release:check": "tsx scripts/release/check.ts",
    "changeset": "changeset",
    "version-packages": "pnpm run changeset version && pnpm install && pnpm run licenses:update && pnpm run format",
    "release:plan": "pnpm run raypx-kit-dev release plan",
    "release:pack": "pnpm run raypx-kit-dev release pack",
    "release:publish": "pnpm run raypx-kit-dev release publish",
    "release:snapshot": "pnpm run raypx-kit-dev release snapshot",
    "release:ci": "pnpm run raypx-kit-dev release pack --from-compatibility .artifacts/compatibility && pnpm run release:publish",
    "docs:dev": "tsx scripts/tasks/run.ts dev --filter=docs",
    "docs:build": "tsx scripts/tasks/run.ts build --filter=docs",
    "docs:preview": "pnpm --dir docs run preview",
    "docs:check": "pnpm --dir docs run check",
    "docs:deploy": "pnpm run docs:build:cloudflare && TOOLKIT_DOCS_BUILT=1 node node_modules/wrangler/bin/wrangler.js deploy",
    "licenses:update": "pnpm run raypx-kit-dev licenses",
    "licenses:check": "pnpm run raypx-kit-dev licenses --check",
    "test:e2e": "tsx e2e/run.ts",
    "test:e2e:install": "playwright install chromium",
    "verify:e2e": "tsx e2e/run.ts --skip-build",
    "docs:build:cloudflare": "pnpm --dir docs run build:cloudflare",
    "workspace:sync": "tsx scripts/checks/workspace.ts --write"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.64.1",
    "@raypx-kit/tsconfig": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "citty": "^0.2.2",
    "confbox": "^0.3.2",
    "knip": "^6.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "semver": "^7.8.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite-plus": "^1.4.0",
    "wrangler": "^4.155.0"
  },
  "overrides": {
    "@react-email/render": "catalog:",
    "vite": "npm:@voidzero-dev/vite-plus-core@^1.4.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "22.22.2",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "22.22.2"
  },
  "packageManager": "pnpm@12.16.1"
}
