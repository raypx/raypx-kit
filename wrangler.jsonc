{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "raypx-kit-docs",
  "main": "./docs/.output/server/index.mjs",
  "build": {
    // Prerendering previews use built output; Workers Builds has its own build step.
    "command": "if [ \"$WRANGLER_COMMAND\" != \"dev\" ] && [ \"$WORKERS_CI\" != \"1\" ] && [ \"$TOOLKIT_DOCS_BUILT\" != \"1\" ]; then bun run docs:build:cloudflare; fi",
    "watch_dir": "./docs/.output/server",
  },
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.mjs", "**/*.js"] }],
  "assets": {
    "binding": "ASSETS",
    "directory": "./docs/.output/public",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/api/*"],
  },
}
