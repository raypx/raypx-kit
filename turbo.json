{
  "$schema": "https://turbo.build/schema.json",
  "envMode": "loose",
  "tasks": {
    "check": {
      "dependsOn": ["^check"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [".artifacts/junit.xml"]
    },
    "build": {
      "dependsOn": ["check", "^build"],
      "outputs": ["dist/**", ".output/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalDependencies": [
    ".nvmrc",
    "mise.toml",
    "devkit.config.ts",
    "scripts/checks/toolchain.ts",
    "packages/devkit/src/toolchain.ts",
    "tests/setup/**",
    "docs/**",
    "README.md",
    ".changeset/README.md",
    "PRODUCT.md",
    "packages/*/README.md",
    "packages/*/NOTICE.md",
    "packages/*/LICENSE",
    "packages/tsconfig/*.json",
    "tests/config.ts"
  ]
}
